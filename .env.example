# Local development / tooling
DATABASE_URL=postgres://fantasy:change-me@localhost:5432/fantasy

# Optional: integration tests use this DB instead of DATABASE_URL (default: …/fantasy_test)
# TEST_DATABASE_URL=

# Optional transfer E2E: E2E_TRANSFERS=1 after scripts/e2e-prepare-transfers.ts
# E2E_TRANSFERS=1

# Admin (used on first `pnpm db:seed` — min 12 characters)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-12-chars

# Required in production (min 32 characters)
SESSION_SECRET=dev-only-change-this-to-a-long-random-string

# Optional: protects GET /api/cron/ensure-matchday (auto Sunday gameweeks)
# CRON_SECRET=

# Docker Compose (VPS)
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fantasy
# Domain served by Caddy (HTTPS is automatic for real domains)
SITE_ADDRESS=localhost
