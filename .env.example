# Local development / tooling
DATABASE_URL=postgres://fantasy:change-me@localhost:5432/fantasy

# Admin (used on first `pnpm db:seed` — min 12 characters)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-12-chars

# Required in production (min 32 characters)
SESSION_SECRET=dev-only-change-this-to-a-long-random-string

# Docker Compose (VPS)
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fantasy
# Domain served by Caddy (HTTPS is automatic for real domains)
SITE_ADDRESS=localhost
